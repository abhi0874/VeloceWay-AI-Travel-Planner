# ── VeloceWay backend configuration ──────────────────────────────────────────────
# Get a FREE Gemini key at https://aistudio.google.com/apikey
# ⚠️  NEVER link a billing account / payment method to your Google AI Studio
#     project — the free tier does not require it, and linking it can incur
#     charges. If you are ever prompted to enable billing, stop.
GEMINI_API_KEY=

# Optional: xAI (Grok). ⚠️ Grok has NO permanent free API tier — only use this
# if you already hold promotional credits. Gemini is the $0-safe default.
GROK_API_KEY=

# "gemini" (recommended) or "grok"
AI_PROVIDER=gemini

# Model ids — override to whatever your AI Studio console lists.
# Examples: gemini-3.6-flash, gemini-2.5-flash, or a newer Flash model.
GEMINI_MODEL=gemini-3.6-flash
GROK_MODEL=grok-4.3

# Port for the local zero-dependency API server (`npm run dev:api`). Local only —
# a serverless host assigns its own port, so leave this unset when deploying.
PORT=8787

# When no key is configured, serve rich sample responses so the app is fully
# explorable offline. Set to 0 to disable — do that in production, so a missing
# or misnamed key fails visibly instead of quietly serving the same sample trip
# for every destination.
WANDOR_ALLOW_MOCK=1

# ── Frontend ──────────────────────────────────────────────────────────────────
# Optional: absolute URL of a hosted backend (e.g. https://wandor-api.vercel.app).
# Only needed when the site and the API live on different hosts. Leave empty in
# dev (Vite proxies /api to the local server) and on a single-host deploy such as
# Vercel, where /api sits on the same domain.
VITE_API_URL=

# ── Firebase (required for accounts + trip history) ───────────────────────────
# Create a free project at https://console.firebase.google.com — full steps in
# FIREBASE_SETUP.md. Planning works without these, but trip history does not:
# it is stored in the traveller's account and never on their device, so with no
# Firebase project there is nowhere to keep it.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional — copied straight from the Firebase web-config snippet.
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=
